# Single source of truth for a build. Bump TALOS_VERSION, re-run the workflow.
# Renovate can track these (see renovate.json regex managers).

# Talos release to build (the tag in siderolabs/talos and siderolabs/imager flow).
TALOS_VERSION=v1.13.5

# git ref to check out in siderolabs/pkgs. pkgs is branch-per-minor; the sed patch
# makes the tree "dirty" so the produced kernel image tag ends in "-dirty".
PKGS_REF=release-1.13

# git ref to check out in siderolabs/extensions. Extensions are tagged per release;
# if there is no exact patch tag, use the matching minor tag (e.g. v1.13.0).
EXTENSIONS_REF=v1.13.5

# amd64 only — these are Intel Macs.
PLATFORM=linux/amd64
ARCH=amd64

# Stock (unmodified) extensions from the Image Factory. These are userspace/firmware
# only (no out-of-tree kernel modules) so they do NOT need rebuilding against the
# custom kernel. i915 IS rebuilt (see scripts/build.sh) because it ships .ko modules.
#
# Pin these to digests before trusting them in your cluster. Values below match the
# talmac schematic 2385c7da... extension set; verify current digests on ghcr.
EXT_INTEL_UCODE=ghcr.io/siderolabs/intel-ucode:20260512
EXT_ISCSI_TOOLS=ghcr.io/siderolabs/iscsi-tools:v0.2.0
EXT_UTIL_LINUX=ghcr.io/siderolabs/util-linux-tools:2.41.4
EXT_THUNDERBOLT=ghcr.io/siderolabs/thunderbolt:20260227
# NOTE: if thunderbolt/USB (your Longhorn USB enclosure, smarthome adapter) misbehaves
# after upgrade, thunderbolt may ship a kernel module for your hardware — rebuild it
# the same way i915 is rebuilt and reference the custom image here instead.
