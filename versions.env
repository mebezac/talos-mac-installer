# Fallback inputs for local runs / workflow_dispatch. On a tag push the workflow
# overrides TALOS_VERSION with the pushed tag. Renovate tracks these (renovate.json).

# Talos release to build. The pkgs ref is NOT set here — build.sh reads the exact pkgs
# commit that this talos release pins (Makefile `PKGS ?= v1.13.0-N-gSHA`), which avoids
# the branch-drift kernel-checksum mismatch.
TALOS_VERSION=v1.13.7

# Optional override for the siderolabs/extensions ref. Defaults to TALOS_VERSION in
# build.sh (extensions tag every patch). Set only if a patch tag is missing.
# EXTENSIONS_REF=v1.13.7

# amd64 only — these are Intel Macs.
PLATFORM=linux/amd64
ARCH=amd64

# Stock (unmodified) extensions from the Image Factory. These are userspace/firmware
# only (no out-of-tree kernel modules) so they are pulled STOCK. i915 AND thunderbolt
# are rebuilt against the custom kernel (see scripts/build.sh MODULE_EXTS) because they
# ship signed .ko modules — a stock image is signed with siderolabs' key and our kernel
# (which enforces module signatures with our build's key) would reject it.
#
# Tags below are the exact versions the Image Factory resolves for this Talos release
# (factory.talos.dev/version/<TALOS_VERSION>/extensions/official). Pin to digests before
# trusting in your cluster. Do NOT let Renovate drift util-linux-tools off the factory
# tag (2.41.4 for v1.13.5) — a mismatched userspace tool is harmless but unblessed.
EXT_INTEL_UCODE=ghcr.io/siderolabs/intel-ucode:20260512
EXT_ISCSI_TOOLS=ghcr.io/siderolabs/iscsi-tools:v0.2.0
EXT_UTIL_LINUX=ghcr.io/siderolabs/util-linux-tools:2.42.0
